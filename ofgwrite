#!/bin/sh

set -e

cleanup_newroot() {
	while grep -q " /newroot " /proc/mounts 2>/dev/null; do
		umount -l /newroot >/dev/null 2>&1 || true
		sleep 0.2
	done
	rm -rf /newroot >/dev/null 2>&1 || true
}

cleanup_newroot

mkdir -p /newroot
mount -t tmpfs tmpfs /newroot
ln -sfn / /newroot/newroot
dry_run=0

stage_inject_arg() {
	arg="$1"
	opt="${arg%%=*}"
	src="${arg#*=}"

	case "${src}" in
		/*)
			[ -f "${src}" ] || {
				printf '%s\n' "${arg}"
				return 0
			}
			mkdir -p /newroot/ofgwrite-inject
			base="${src##*/}"
			dst="/newroot/ofgwrite-inject/${base}"
			cp -p "${src}" "${dst}"
			printf '%s=%s\n' "${opt}" "${dst}"
			;;
		*)
			printf '%s\n' "${arg}"
			;;
	esac
}

argc="$#"
while [ "${argc}" -gt 0 ]; do
	arg="$1"
	shift
	argc=$((argc - 1))

	case "${arg}" in
		-n|--nowrite)
			dry_run=1
			;;
		--inject-backup=*|--inject-marker=*|--inject-restore-helper=*|--inject-restore-service=*)
			arg="$(stage_inject_arg "${arg}")"
			;;
	esac

	set -- "$@" "${arg}"
done

if [ -e /tmp/backup_flash.tar.gz ]; then
	mv /tmp/backup_flash.tar.gz /newroot/
fi

cp -p /usr/bin/ofgwrite_bin /newroot/

# Prevent mount propagation surprises on systemd-based systems before pivot_root.
mount --make-rprivate / >/dev/null 2>&1 || true

/newroot/ofgwrite_bin "$@"
rc=$?

# Only clean up /newroot if ofgwrite_bin failed. Exit 0 means the process
# daemonized successfully and the flash is still running in the background.
if [ "$rc" -ne 0 ] || [ "${dry_run}" = "1" ]; then
	cleanup_newroot
fi
